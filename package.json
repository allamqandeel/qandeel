{
  "name": "qandeel",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "build:api": "npm run build --workspace @qandeel/api",
    "start:api": "npm run start:dev --workspace @qandeel/api",
    "test:api": "npm run test --workspace @qandeel/api",
    "test:database": "node --test database/tests/*.test.mjs",
    "test:toolchain": "node --test tests/toolchain.test.mjs",
    "verify:integrations:diagnose": "node scripts/diagnose-integrations.mjs",
    "verify:database:integration": "node --env-file-if-exists=.env database/verify-migration-0002.mjs",
    "verify:memory:integration": "node --env-file-if-exists=.env database/verify-migration-0004.mjs",
    "verify:hypothesis:integration": "node --env-file-if-exists=.env database/verify-migration-0005.mjs",
    "verify:confidence:integration": "node --env-file-if-exists=.env database/verify-migration-0006.mjs",
    "verify:question:integration": "node --env-file-if-exists=.env database/verify-migration-0007.mjs",
    "verify:hypothesis-update:integration": "node --env-file-if-exists=.env database/verify-migration-0008.mjs",
    "verify:him:integration": "node --env-file-if-exists=.env database/verify-migration-0009.mjs",
    "verify:auth:smoke": "node --env-file=.env database/verify-supabase-auth.mjs",
    "verify:claude:smoke": "node --env-file-if-exists=.env node_modules/ts-node/dist/bin.js --project apps/api/tsconfig.json apps/api/scripts/verify-claude-smoke.ts",
    "verify:openai:smoke": "node --env-file-if-exists=.env node_modules/ts-node/dist/bin.js --project apps/api/tsconfig.json apps/api/scripts/verify-openai-smoke.ts",
    "eval:brain:validate": "node node_modules/ts-node/dist/bin.js --project apps/api/tsconfig.json apps/api/scripts/brain-eval.ts validate",
    "eval:brain:run": "node --env-file-if-exists=.env node_modules/ts-node/dist/bin.js --project apps/api/tsconfig.json apps/api/scripts/brain-eval.ts run",
    "eval:brain:dry-run": "node node_modules/ts-node/dist/bin.js --project apps/api/tsconfig.json apps/api/scripts/brain-eval.ts dry-run",
    "eval:brain:summarize": "node node_modules/ts-node/dist/bin.js --project apps/api/tsconfig.json apps/api/scripts/brain-eval.ts summarize",
    "verify:initial-him:integration": "node --env-file-if-exists=.env database/verify-migration-0010.mjs",
    "verify:him-calculation:integration": "node --env-file-if-exists=.env database/verify-migration-0011.mjs",
    "verify:hse-energy:integration": "node --env-file-if-exists=.env database/verify-migration-0012.mjs",
    "verify:hse-motivation:integration": "node --env-file-if-exists=.env database/verify-migration-0013.mjs",
    "verify:hse-attention:integration": "node --env-file-if-exists=.env database/verify-migration-0014.mjs",
    "verify:hse-self-confidence:integration": "node --env-file-if-exists=.env database/verify-migration-0015.mjs",
    "verify:hse-stress:integration": "node --env-file-if-exists=.env database/verify-migration-0016.mjs",
    "verify:him-trends:integration": "node --env-file-if-exists=.env database/verify-him-trends-v1.mjs",
    "verify:him-snapshot:integration": "node --env-file-if-exists=.env database/verify-him-intelligence-snapshot-v1.mjs",
    "verify:runtime-events:integration": "node --env-file-if-exists=.env database/verify-runtime-event-outbox-v1.mjs",
    "verify:background-intelligence-adapters:integration": "node --env-file-if-exists=.env database/verify-migration-0021.mjs",
    "verify:post-response-intelligence-db:integration": "node --env-file-if-exists=.env database/verify-migration-0022.mjs",
    "verify:association-provider-effect-key:integration": "node --env-file-if-exists=.env database/verify-migration-0023.mjs",
    "verify:post-response-dispatch:integration": "node --env-file-if-exists=.env scripts/verify-post-response-redis.mjs",
    "verify:him-measurement-preflight": "node --test tests/him-structured-measurement-preflight.test.mjs && npm run test:api && npm run test:database && node node_modules/typescript/bin/tsc -p apps/api/tsconfig.json --noEmit && npm run build:api",
    "verify:foundation-integration-gate": "npm run test --workspace @qandeel/api -- --runInBand --runTestsByPath src/human-model/him-foundation-integration-regression-gate.spec.ts && node --test tests/him-foundation-integration-regression-gate.test.mjs"
  },
  "devDependencies": {"pg": "^8.16.3"},
  "engines": {"node": ">=20", "npm": ">=10"}
}

