# QANDEEL local environment template
NODE_ENV=development
PORT=3000

# Database / cache
DATABASE_URL=
REDIS_URL=

# Authentication
AUTH_SECRET=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only conversation authority (claim/finalize/fail) and Memory authority
# (create/mark-deleted/supersede). Never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=
# The ONLY key that may carry Sb-Forwarded-For (Login ID sign-in, verification, Account Security). A Supabase
# SECRET key, never the publishable or service-role key. Required in production (PROD-SEC-01).
SUPABASE_SECRET_KEY=
SUPABASE_TEST_EMAIL=
SUPABASE_TEST_PASSWORD=

# AI provider (S8A-03 D1): DeepSeek Flash for every AI call - the reply router and the seven structured adapters.
# There is no OpenAI, Anthropic or Gemini provider and no fallback. Qualification only: DeepSeek may process synthetic
# data only, a production process refuses it, and DEEPSEEK_QUALIFICATION_MODE must be declared (QAN-BL-AI-01).
MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_QUALIFICATION_MODE=SYNTHETIC_ONLY
HYPOTHESIS_CANDIDATE_GENERATION_TIMEOUT_MS=5000
HYPOTHESIS_CANDIDATE_GENERATION_MAX_OUTPUT_TOKENS=4096

# Memory confidence of a MACHINE_ASR voice turn (S8B-02 P-1): controlled configuration, not an accuracy claim. A LOW band
# writes no Memory. Each value is above 0 and below 0.95, MEDIUM never above HIGH; unset keeps these approved defaults,
# and any other value stops the API from starting.
MACHINE_ASR_MEMORY_CONFIDENCE_HIGH=0.90
MACHINE_ASR_MEMORY_CONFIDENCE_MEDIUM=0.75
# S8B-03 Personal Voice Notes: the server-only Speechmatics batch key (never in a client). Unset, no note is ever sent and
# the transcription worker stays off; the EU endpoint is the default. Reconciliation by tracking reference stays off until
# proven (PC-S2). The instance count bounds the per-instance rate limits; the bands are the ASR confidence thresholds.
SPEECHMATICS_API_KEY=
SPEECHMATICS_BATCH_BASE_URL=
SPEECHMATICS_RECONCILE_BY_REFERENCE=
VOICE_API_INSTANCES=
VOICE_TRANSCRIPTION_CONCURRENCY=
VOICE_TRANSCRIPTION_WORKER_DISABLED=
VOICE_ASR_BAND_HIGH=
VOICE_ASR_BAND_MEDIUM=

# Trusted client address (PROD-SEC-01). direct = the API is reached by clients itself; trusted_proxy = behind
# reverse proxies whose exact IPs / CIDRs are listed (comma-separated). Never 'true', never a hop count.
# Required explicitly in production; see infra/LAUNCH_EDGE_SECURITY_CONTRACT_v1.md.
QANDEEL_API_PROXY_MODE=direct
QANDEEL_API_TRUSTED_PROXIES=

# Shared ID sealing (S4-01). The owner-readable Shared ID is stored only as an AES-256-GCM ciphertext the database cannot
# open; the key lives HERE (a secret store in production), never in the repository or the database. Format:
# `1:<base64 of 32 random bytes>[,2:<…>]` — every version that may still open a stored value — and the version new values
# are sealed under. Absent or malformed: the Shared ID routes fail closed (503); nothing falls back to a clear value.
QANDEEL_SHARED_ID_SEALING_KEYS=
QANDEEL_SHARED_ID_SEALING_ACTIVE_VERSION=1

# Introduction photos (S6-06, D-01): the private S3-protocol object store - Supabase Storage's S3 endpoint when hosted
# (https://<ref>.storage.supabase.co/storage/v1/s3, path-style). Server-only: these keys bypass storage RLS, so they live
# in the API's environment (a secret store in production) and never in a client, the database or a log. Absent: every
# photo route answers UNAVAILABLE and the erasure worker stays off. A plain-http endpoint is accepted on loopback only.
QANDEEL_MEDIA_S3_ENDPOINT=
QANDEEL_MEDIA_S3_REGION=
QANDEEL_MEDIA_S3_BUCKET=
QANDEEL_MEDIA_S3_ACCESS_KEY_ID=
QANDEEL_MEDIA_S3_SECRET_ACCESS_KEY=

# Observability
SENTRY_DSN=
