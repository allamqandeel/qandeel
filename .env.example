# QANDEEL local environment template
NODE_ENV=development
PORT=3000

# Database / cache
DATABASE_URL=
REDIS_URL=

# Authentication
AUTH_SECRET=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only conversation authority (claim/finalize/fail) and Memory authority
# (create/mark-deleted/supersede). Never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=
# The ONLY key that may carry Sb-Forwarded-For (Login ID sign-in, verification, Account Security). A Supabase
# SECRET key, never the publishable or service-role key. Required in production (PROD-SEC-01).
SUPABASE_SECRET_KEY=
SUPABASE_TEST_EMAIL=
SUPABASE_TEST_PASSWORD=

# AI providers — keep provider choice configurable
MODEL_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
HYPOTHESIS_CANDIDATE_GENERATION_PROVIDER=GEMINI
HYPOTHESIS_CANDIDATE_GENERATION_MODEL=gemini-2.5-flash
HYPOTHESIS_CANDIDATE_GENERATION_TIMEOUT_MS=5000
HYPOTHESIS_CANDIDATE_GENERATION_MAX_OUTPUT_TOKENS=65536

# Trusted client address (PROD-SEC-01). direct = the API is reached by clients itself; trusted_proxy = behind
# reverse proxies whose exact IPs / CIDRs are listed (comma-separated). Never 'true', never a hop count.
# Required explicitly in production; see infra/LAUNCH_EDGE_SECURITY_CONTRACT_v1.md.
QANDEEL_API_PROXY_MODE=direct
QANDEEL_API_TRUSTED_PROXIES=

# Shared ID sealing (S4-01). The owner-readable Shared ID is stored only as an AES-256-GCM ciphertext the database cannot
# open; the key lives HERE (a secret store in production), never in the repository or the database. Format:
# `1:<base64 of 32 random bytes>[,2:<…>]` — every version that may still open a stored value — and the version new values
# are sealed under. Absent or malformed: the Shared ID routes fail closed (503); nothing falls back to a clear value.
QANDEEL_SHARED_ID_SEALING_KEYS=
QANDEEL_SHARED_ID_SEALING_ACTIVE_VERSION=1

# Observability
SENTRY_DSN=
