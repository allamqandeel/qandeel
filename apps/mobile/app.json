{
  "expo": {
    "name": "QANDEEL",
    "slug": "qandeel",
    "version": "0.1.0",
    "scheme": "qandeel",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.qandeel.mobile",
      "userInterfaceStyle": "automatic",
      "infoPlist": {
        "CFBundleLocalizations": [
          "ar",
          "en"
        ]
      }
    },
    "android": {
      "package": "com.qandeel.mobile"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-qandeel-launch-identity"
    ]
  }
}
