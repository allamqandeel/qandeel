{
  "expo": {
    "name": "QANDEEL",
    "slug": "qandeel",
    "version": "0.1.0",
    "scheme": "qandeel",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.qandeel.mobile",
      "userInterfaceStyle": "automatic",
      "infoPlist": {
        "CFBundleLocalizations": [
          "ar",
          "en"
        ]
      }
    },
    "android": {
      "package": "com.qandeel.mobile",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "./plugins/with-qandeel-launch-identity",
      "./plugins/with-qandeel-push",
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "QANDEEL uses only the photo you choose, to share it in your introduction.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "locales": {
      "ar": "./locales/ar.json",
      "en": "./locales/en.json"
    }
  }
}
